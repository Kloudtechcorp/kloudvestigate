# KloudTrack internal API
KLOUDTRACK_API_BASE_URL=https://api.kloudtechsea.com/api/v1
KLOUDTRACK_API_TOKEN=
# Minimum gap between upstream requests sharing an origin and API token.
KLOUDTRACK_REQUEST_GAP_MS=350
KLOUDTRACK_REQUEST_TIMEOUT_MS=120000
# Request budget per KloudTrack API key, matching KloudTrack's limits (count/window: s, m, h, d), or "off".
KLOUDTRACK_RATE_LIMITS=3/1s,20/1m,100/15m,1000/1h,10000/1d
# Share of each limit this app uses, leaving room for other users of the key (0-1).
KLOUDTRACK_RATE_LIMIT_SHARE=0.8

# KloudTrack beta internal API
BETA_KLOUDTRACK_API_BASE_URL=https://beta-api.kloudtechsea.com/api/v1
BETA_KLOUDTRACK_API_TOKEN=

# Internal app access
# Required in production. Used as the shared login password and legacy API Bearer/header token.
# In local development, pages and APIs allow access if this is unset.
INTERNAL_ACCESS_TOKEN=

# Protects /api/cron/daily-station-investigations.
# Vercel sends this value as an Authorization Bearer token for cron requests.
CRON_SECRET=

# Allows server-to-server requests through Vercel Deployment Protection.
# Vercel automatically provides this after Protection Bypass for Automation is configured.
VERCEL_AUTOMATION_BYPASS_SECRET=

# App runtime
NODE_ENV=development

DATABASE_URL=
DIRECT_URL=
