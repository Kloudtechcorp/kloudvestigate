# KloudTrack internal API
KLOUDTRACK_API_BASE_URL=https://api.kloudtechsea.com/api/v1
KLOUDTRACK_API_TOKEN=

# KloudTrack beta internal API
BETA_KLOUDTRACK_API_BASE_URL=https://beta-api.kloudtechsea.com/api/v1
BETA_KLOUDTRACK_API_TOKEN=

# Internal app access
# Required in production. Used as the shared login password and legacy API Bearer/header token.
# In local development, pages and APIs allow access if this is unset.
INTERNAL_ACCESS_TOKEN=

# Protects /api/cron/daily-station-investigations.
# Vercel sends this value as an Authorization Bearer token for cron requests.
CRON_SECRET=

# App runtime
NODE_ENV=development

DATABASE_URL=
DIRECT_URL=
